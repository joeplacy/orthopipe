# Local development defaults. Never commit real secrets or patient data.
ORTHOPIPE_HOST=127.0.0.1
ORTHOPIPE_PORT=8000
ORTHOPIPE_DATA_DIR=./var
ORTHOPIPE_MAX_UPLOAD_BYTES=104857600
ORTHOPIPE_RX_BACKEND=anthropic
# ANTHROPIC_API_KEY=set-in-your-shell-or-secret-manager
# ORTHOPIPE_RX_LOCAL_MODEL=llama3.1
